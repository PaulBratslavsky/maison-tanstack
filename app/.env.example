# `npm install` at the repo root copies this to .env, or adds missing keys to an existing .env. It never changes a
# value you set. Never commit .env. Names starting with VITE_ are built into the browser code: never put a secret in one.

# Where the browser reaches Strapi, and the app's OAuth client. `npm run setup` fills in the client ID.
VITE_STRAPI_URL=http://localhost:1339
VITE_MAISON_CLIENT_ID=

# LINE. Mock mode signs in a demo customer with LINE's LIFF mock. `npm run mode:line` sets it to false, with your
# LIFF ID, to run inside LINE.
VITE_LIFF_MOCK=true
VITE_LIFF_ID=
VITE_DEMO_LINE_USER_ID=
VITE_DEMO_LOCALE=en
# Maison's LINE Official Account basic ID, with the @. Empty means no "Chat with Maison on LINE" button.
VITE_LINE_OA_ID=
# LINE mode inputs for `npm run mode:line`, `npm run qr` and `npm run tunnel`. The app does not read them.
LINE_MODE_LIFF_ID=
LINE_MODE_CHANNEL_ID=
LINE_MODE_DOMAIN=

# Where the app's server reaches Strapi: the concierge, the Home page text and the LINE mode proxy.
STRAPI_URL=http://127.0.0.1:1339

# The local stand-in for LINE's ID token verify endpoint. The channel ID must match strapi/.env in local mode.
LINE_LOGIN_CHANNEL_ID=1234567890
MOCK_LINE_VERIFY_PORT=4546

# The concierge's model: Claude Sonnet 5.5 with ANTHROPIC_API_KEY. Without it, a local model through Ollama.
ANTHROPIC_API_KEY=
OLLAMA_MODEL=qwen3-14b-32k
# A trailing /v1 is dropped, so the value from maison-demo works as it is.
OLLAMA_BASE_URL=http://127.0.0.1:11434
