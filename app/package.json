{
  "name": "maison-app",
  "version": "0.1.0",
  "private": true,
  "description": "The Maison customer app: TanStack Start, with TanStack AI for the concierge.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node ../scripts/line-mode.mjs require-local",
    "dev": "concurrently -k -n app,line-verify -c green,cyan \"vite dev --host 127.0.0.1 --port 3004 --strictPort\" \"node --env-file-if-exists=.env ../scripts/mock-line-verify.mjs --reuse\"",
    "build": "vite build",
    "start": "concurrently -k -n app,line-verify -c green,cyan \"vite preview --host 127.0.0.1 --port 3004 --strictPort\" \"node --env-file-if-exists=.env ../scripts/mock-line-verify.mjs --reuse\"",
    "start:line": "node ../scripts/line-mode.mjs require-line && vite build && vite preview --host 127.0.0.1 --port 3004 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test:e2e": "node --env-file=../strapi/.env --env-file=.env node_modules/@playwright/test/cli.js test",
    "typecheck:live": "tsc --noEmit -p tsconfig.live.json",
    "test:live": "node --env-file=../strapi/.env --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.live.config.ts",
    "test:live:claude": "LIVE_MODEL=claude npm run test:live"
  },
  "dependencies": {
    "@fontsource/jost": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.0",
    "@line/liff": "^2.31.2",
    "@line/liff-mock": "^1.0.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tanstack/ai": "0.68.0",
    "@tanstack/ai-anthropic": "0.21.1",
    "@tanstack/ai-client": "0.39.2",
    "@tanstack/ai-ollama": "0.11.16",
    "@tanstack/ai-react": "0.30.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "nitro": "3.0.260903-beta",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
