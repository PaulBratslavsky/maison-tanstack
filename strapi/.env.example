# `npm install` at the repo root copies this to .env, or adds missing keys to an existing .env, and generates every
# value marked tobemodified. It never changes a value you set. Never commit .env.
HOST=127.0.0.1
PORT=1339
APP_KEYS=tobemodified
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# The demo's admin. `npm run setup` registers it on a fresh database, and the scripts and tests sign in with it.
# To sign in to the admin yourself, open this file in your editor and read both values.
DEMO_ADMIN_EMAIL=demo@maison.local
DEMO_ADMIN_PASSWORD=tobemodified

# LINE sign-in. The LINE Login channel's ID, digits only, not the LIFF ID. The local mock accepts 1234567890.
LINE_LOGIN_CHANNEL_ID=1234567890
# Local only: check LINE ID tokens with the local mock. Strapi ignores it when NODE_ENV=production.
LINE_VERIFY_URL=http://127.0.0.1:4546/verify
# The base of the links in LINE confirmations: the app's address, with no trailing slash.
MAISON_LIFF_URL=http://localhost:3004
# The LINE Official Account's Messaging API channel access token. With it, Strapi sends a LINE confirmation when
# staff confirm a visit. In local mode, point MAISON_LINE_API_BASE_URL at the stand-in so nothing reaches a phone.
LINE_CHANNEL_ACCESS_TOKEN=
MAISON_LINE_API_BASE_URL=
# Another origin that calls Strapi directly from the browser. Strapi's CORS adds it.
MAISON_APP_ORIGIN=
# Strapi's public https address, for media URLs and OAuth metadata. Empty in local mode.
PUBLIC_URL=

# Inquiry labelling. AI_PROVIDER is anthropic (the default) or ollama. AI_MODEL defaults to
# claude-haiku-4-5-20251001 for Anthropic. AI_BASE_URL is the Ollama host, such as http://127.0.0.1:11434.
# With no key and no Ollama host, labelling is off and inquiries wait under Not labelled.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
# The staff assistant's model. It uses AI_API_KEY, an Anthropic key. Empty means claude-sonnet-5-5.
AI_CHAT_MODEL=
# Optional: your own LINE user ID, U and 32 lowercase hex characters. With it, Load demo activity gives your LINE
# account one waiting request, one open question and one open complaint.
MAISON_DEMO_LINE_USER_ID=
