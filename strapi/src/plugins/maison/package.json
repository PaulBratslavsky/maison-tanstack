{
  "name": "maison",
  "version": "0.1.0",
  "description": "Maison: a Strapi 5 plugin for a luxury house's catalog, appointments and inquiries, with Strapi's built-in MCP server and TanStack AI.",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "mcp"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "server/seed"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:integration": "npm run build",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.mjs\"",
    "test:ts:front": "tsc -p admin/tsconfig.json --noEmit",
    "test:ts:back": "tsc -p server/tsconfig.json --noEmit"
  },
  "strapi": {
    "kind": "plugin",
    "name": "maison",
    "displayName": "Maison",
    "description": "A luxury house's catalog and appointments, as MCP tools for people's apps and agents."
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "5.57.0",
    "@strapi/typescript-utils": "5.57.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.5.3",
    "typescript": "^5.9.3",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.57.0",
    "@strapi/utils": "^5.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.5.3"
  }
}
